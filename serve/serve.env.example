# serve.env - the FULL launch recipe. serve-engram-vision.sh sources this with
# `set -a`, so ANY bare launch resolves to the exact healthy-arm config.
# Do not trim: every line below is load-bearing (see the 2026-09-17 wedge
# storm - a bare relaunch without these defaulted to the pinned-Engram path
# and hard-wedged the box at model load).
API_KEY=change-me                 # required; clients send it as Bearer token
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=64   # prefix-cache commit fix (see README RCA 1)
NCCL_P2P_DISABLE=1                        # P2P init deadlock on asymmetric pairs (RCA 2)
PACK=/mnt/nvme0/bigmodels/dsv41-ablit-engram-q4   # this checkpoint
ENGRAM_DISK=1                             # NON-NEGOTIABLE on 125G boxes: pinned path wants ~190G
EAGER=0
PORT=8000
DSV41_ENGRAM_DEDUP=1
ENGRAM_THREADS=64
MAX_MODEL_LEN=1048576
RECIPE=/mnt/nvme0/bigmodels/dsv41-exl3-2.0bpw/recipe
MOUNTS_EXTRA="-v $RECIPE/patches/vllm/kv_cache_coordinator.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/kv_cache_coordinator.py:ro -v $RECIPE/patches/vllm/single_type_kv_cache_manager.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/single_type_kv_cache_manager.py:ro"
